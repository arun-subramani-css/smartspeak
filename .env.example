# SmartSpeak Environment Configuration
# Copy this file to .env and replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app>
MONGODB_DB_NAME=smartspeak
STORAGE_DIR=./data
MAX_UPLOAD_SIZE_MB=500
FRAME_SAMPLE_RATE_FPS=1.0
RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24
PORT=8000
HOST=0.0.0.0
