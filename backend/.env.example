# SmartSpeak Environment Configuration
# Copy this file to .env and replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app>
MONGODB_DB_NAME=smartspeak
STORAGE_DIR=./data
# Optional: directory containing trained model artifacts (confidence_model.pkl, posture_model.pkl).
# Defaults to the repository-root models/ directory if unset.
# MODELS_DIR=./models
MAX_UPLOAD_SIZE_MB=500
FRAME_SAMPLE_RATE_FPS=1.0
RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24
PORT=8000
HOST=0.0.0.0

# --- Performance tuning -----------------------------------------------------
# Prewarm Whisper/spaCy/confidence models at startup (recommended).
PREWARM_MODELS=true
# Whisper decoding: beam_size=1 (greedy) is ~3.5x faster with near-identical
# accuracy when audio is denoised upstream. Raise only for very noisy inputs.
WHISPER_BEAM_SIZE=1
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Eye-contact pass: parallel workers (each with its own VideoCapture + MediaPipe),
# capped at CPU count. Lower this if the machine is CPU-starved during analysis.
EYE_CONTACT_MAX_WORKERS=3

# CORS
CORS_ALLOW_ORIGINS=*  # comma-separated, e.g. http://localhost:5173,https://yourapp.com
